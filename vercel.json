{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/img/:file", "destination": "/:file" },
    { "source": "/icons/:file", "destination": "/:file" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/supabase-config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
