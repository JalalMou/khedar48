{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/callcentre",
      "destination": "/callcenter",
      "permanent": false
    },
    {
      "source": "/call-center",
      "destination": "/callcenter",
      "permanent": false
    },
    {
      "source": "/call-centre",
      "destination": "/callcenter",
      "permanent": false
    },
    {
      "source": "/cc",
      "destination": "/callcenter",
      "permanent": false
    },
    {
      "source": "/livreurs",
      "destination": "/livreur",
      "permanent": false
    },
    {
      "source": "/driver",
      "destination": "/livreur",
      "permanent": false
    },
    {
      "source": "/admine",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/livreur",
      "destination": "/index.html"
    },
    {
      "source": "/callcenter",
      "destination": "/index.html"
    },
    {
      "source": "/img/:file",
      "destination": "/:file"
    },
    {
      "source": "/icons/:file",
      "destination": "/:file"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/supabase-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/livreur",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/callcenter",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
